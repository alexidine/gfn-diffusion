# inn_atoms_oct21 flags shared by every arm, read when the job STARTS (edit in place while queued). The stage-1 (likelihood)
# recipe of the local atom-token prototype of 21 Oct (artifacts/inn_proto/proto_oct21.sh: one transformer block of 32 bins,
# tied knot derivatives, height floor 1e-5, noise 10^-2.5..10^-1.5, batch 2048, peak rate 5e-4 on a cosine), run 10x
# longer, one row per molecule. No energy stage. Every option is explicit, so the code defaults do not matter.
ALL	--config configs/mk_dev.yaml --tag inn_atoms21 --prior_path /scratch/mk8347/data/crystal_datasets/conditional/priors/qm9full_prior.pt --molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/qm9full_conditions.pt --test_molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/qm9full_test_conditions.pt --set embedding_conditioning=true --set energy_config.temperature=6.9 --set energy_config.reward_range=null --set energy_config.energy_reference=seed_min --set checkpoints_dir=/scratch/mk8347/projects/gfn_cond/gfn-diffusion/energy_sampling/checkpoints --set gpu_util_sample_period_s=10 --mle_noise_log_range -2.5 -1.5 --conditioner transformer --n_blocks 1 --n_bins 32 --tf_width 256 --tf_layers 4 --tf_heads 8 --context_dim 128 --context_hidden 512 --tied_derivatives --tied_factor 2 --min_bin_height 1e-5 --bank_frac 0 --rows_per_molecule 1 --mle_steps 200000 --mle_batch 2048 --lr_mle 5e-4 --energy_steps 0 --eval_every 5000 --eval_samples 4000 --log_every 100 --util_target 0 --oom_retries 3 --max_minutes 2040
