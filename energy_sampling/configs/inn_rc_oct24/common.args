# inn_rc_oct24 flags shared by every arm, read when the job STARTS (edit in place while queued). The stage-1
# (likelihood) recipe of inn_atoms_oct21 (atom-token condition, one transformer block of 32 bins, tied knot derivatives,
# height floor 1e-5, noise 10^-2.5..10^-1.5, batch 2048, peak rate 5e-4 on a cosine, one row per molecule, 200k steps),
# on the rc_oct22 random-conformer priors; the arms set prior_path and molecules_path. No energy stage. Every option is
# explicit, so the code defaults do not matter.
ALL	--config configs/mk_dev.yaml --tag inn_rc24 --test_molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_test_conditions.pt --set embedding_conditioning=true --set energy_config.temperature=6.9 --set energy_config.reward_range=null --set energy_config.energy_reference=seed_min --set checkpoints_dir=/scratch/mk8347/projects/gfn_cond/gfn-diffusion/energy_sampling/checkpoints --set gpu_util_sample_period_s=10 --mle_noise_log_range -2.5 -1.5 --conditioner transformer --n_blocks 1 --n_bins 32 --tf_width 256 --tf_layers 4 --tf_heads 8 --context_dim 128 --context_hidden 512 --tied_derivatives --tied_factor 2 --min_bin_height 1e-5 --bank_frac 0 --atom_tokens --rows_per_molecule 1 --mle_steps 200000 --mle_batch 2048 --lr_mle 5e-4 --energy_steps 0 --eval_every 5000 --eval_samples 4000 --log_every 100 --util_target 0 --oom_retries 3 --max_minutes 2820
