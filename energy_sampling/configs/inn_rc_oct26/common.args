# inn_rc_oct26 flags shared by every arm, read when the job STARTS (edit in place while queued). Stage 2 only
# (--mle_steps 0) from the arm's stage-1 checkpoint (arms.tsv: --init_from), on the stage-1 architecture and data of
# inn_rc_oct25 (atom-token condition, one transformer block of 32 bins, tied knot derivatives); the energy stage of
# inn_oct12's qm9_noise arm with inn_proto2_atoms_oct21's atom-token settings, on a 2400-minute clock (--budget_minutes;
# --max_minutes 2640 is the hard stop, start-up not counted). Every option is explicit, so the code defaults do not
# matter.
ALL	--config configs/mk_dev.yaml --tag inn_rc26 --test_molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_test_conditions.pt --set embedding_conditioning=true --set energy_config.temperature=6.9 --set energy_config.reward_range=null --set energy_config.energy_reference=seed_min --set checkpoints_dir=/scratch/mk8347/projects/gfn_cond/gfn-diffusion/energy_sampling/checkpoints --set gpu_util_sample_period_s=10 --mle_noise_log_range -2.5 -1.5 --conditioner transformer --n_blocks 1 --n_bins 32 --tf_width 256 --tf_layers 4 --tf_heads 8 --context_dim 128 --context_hidden 512 --tied_derivatives --tied_factor 2 --min_bin_height 1e-7 --bank_frac 0 --atom_tokens --rows_per_molecule 1 --mle_steps 0 --tf_fp32 --batch 2000 --stored_batch 4096 --lr_energy 1e-4 --lr_energy_final 1e-5 --energy_warmup 200 --beta_data 10 --data_noise_log_range -3 -1.5 --updates_per_batch 4 --fast_scoring --eval_every 1000 --eval_samples 10000 --budget_minutes 2400 --log_every 100 --util_target 0 --oom_retries 3 --max_minutes 2640
