# inn_cap_oct26 stage 2 (the energy stage), read when a job STARTS (edit in place while queued). Tab-separated:
# name, flags. From an arm's own stage-1 best.pt (arms_s2*.tsv: --init_from and the arm's architecture), on the
# same prior construction as stage 1 (the gauss 6 kT buffer, 4 rows per training condition, rebuilt at start-up
# from the same anchors and churned at every eval), the qm9rc full set. The energy stage of inn_rc_oct26's recipe
# (2,000 draws per scored batch reused for 4 updates, 4,096 stored rows per update, 1e-4 cosine to 1e-5, bin floor
# 1e-7) with draws and stored rows scored against one per-condition level read off the tracker (--level_mode ema,
# mk_dev's condition_log_z: min_visits 20, half-life 200 visits on the condition's own clock, which ticks when the
# condition is in either stream; on this set that is ~0.04 ticks per update, a half-life of ~5k updates, and the
# forward stream is trusted after ~4.4k updates), both Huber knees at 40, and mk_dev's buffer churn (10 rows per
# update); a 600-minute clock (--max_minutes 660 is the hard stop, start-up not counted).
ALL	--config configs/mk_dev.yaml --tag inn_cap26s2 --prior_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_prior.pt --molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_conditions.pt --test_molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_test_conditions.pt --set embedding_conditioning=true --set energy_config.temperature=6.9 --set energy_config.reward_range=null --set energy_config.energy_reference=seed_min --set checkpoints_dir=/scratch/mk8347/projects/gfn_cond/gfn-diffusion/energy_sampling/checkpoints --set gpu_util_sample_period_s=10 --conditioner transformer --n_blocks 1 --n_bins 32 --tf_heads 8 --context_dim 128 --context_hidden 512 --atom_node_dim 128 --atom_convs 3 --tied_derivatives --tied_factor 2 --min_bin_height 1e-7 --bank_frac 0 --atom_tokens --rows_per_molecule 1 --molecule_fraction 1 --mle_steps 0 --tf_fp32 --batch 2000 --stored_batch 4096 --lr_energy 1e-4 --lr_energy_final 1e-5 --energy_warmup 200 --updates_per_batch 4 --fast_scoring --eval_every 1000 --eval_samples 10000 --budget_minutes 600 --max_minutes 660 --log_every 100 --util_target 0 --oom_retries 3 --stored_source buffer --set buffer_device=cpu --set buffers.anchor_buffer.tile=gauss --gauss_excess_kT 6 --pbuf_rows_per_condition 4 --level_mode ema --beta 40 --beta_data 40
