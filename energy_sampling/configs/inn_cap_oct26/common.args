# inn_cap_oct26 flags shared by every arm, read when a job STARTS (edit in place while queued). Tab-separated: name,
# flags. The stage-1 (likelihood) recipe of inn_rc_oct25 on the qm9rc prior (rc_oct22, 114,817 training molecules,
# 1,120,750 rows; held-out conditions 6,652 molecules), 50,000 steps on one cosine from 5e-4 for every arm (matched
# data exposure), evals on 4,000 draws every 2,500 steps. An arm's flags (arms_*.tsv) come after these: later flags win.
ALL	--config configs/mk_dev.yaml --tag inn_cap26 --prior_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_prior.pt --molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_conditions.pt --test_molecules_path /scratch/mk8347/data/crystal_datasets/conditional/priors/rc_oct22/rcoct22i1_qm9rc_test_conditions.pt --set embedding_conditioning=true --set energy_config.temperature=6.9 --set energy_config.reward_range=null --set energy_config.energy_reference=seed_min --set checkpoints_dir=/scratch/mk8347/projects/gfn_cond/gfn-diffusion/energy_sampling/checkpoints --set gpu_util_sample_period_s=10 --mle_noise_log_range -2.5 -1.5 --conditioner transformer --n_blocks 1 --n_bins 32 --tf_width 256 --tf_layers 4 --tf_heads 8 --context_dim 128 --context_hidden 512 --atom_node_dim 128 --atom_convs 3 --tied_derivatives --tied_factor 2 --min_bin_height 1e-5 --bank_frac 0 --atom_tokens --rows_per_molecule 1 --mle_steps 50000 --mle_batch 2048 --lr_mle 5e-4 --energy_steps 0 --eval_every 2500 --eval_samples 4000 --log_every 100 --util_target 0 --oom_retries 3 --max_minutes 2700
