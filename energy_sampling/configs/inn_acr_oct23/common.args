# inn_acr_oct23 flags shared by every run, read when the job STARTS. BOTH: both stages; MLE: stage 1; ENERGY: stage 2;
# SEED_<tag>: the seed flags of a stage-1 run and of the arms that start from it. inn_mps_oct21's flags with acridine's:
# the old MACE checkpoint, P2_1/c (dead rows 3 and 5, so the pose-first order without them), the density wall and the
# implausible-energy screen at the values of the last acridine production arm (ppl_acr_dens_n5), MACE kept off cells
# denser than packing coefficient 2 (energy_config.mlip_max_packing_coeff, scored as clashes), stage-1 noise = the old
# checkpoint's 1 kT kick, the held-out split over all 8 images (rows 6-11), the prior scan cached (stage 1 writes it,
# the arms re-score 512 rows), no --fast_scoring (MACE needs the energy's adaptive chunking), evals every 500 updates,
# the occupancy batch sizer on in both stages (--util_target 0.75: stage 1 grows its likelihood batch, stage 2 its
# stored-row batch, never the fresh draws; --grow_mem_frac 1.0 turns its memory guard off, which MACE's adaptive
# chunking always trips, so an out-of-memory backs the batch off one rung and freezes it), stage 1 at 20k steps
# (owner), rare rollouts in stage 2 (--updates_per_batch 5: each MACE-scored batch of 2000 draws serves 5 updates,
# the GFN production cadence n5; owner), and a 38-hour stage-2 clock (a MACE update costs ~10x an eLJ one). Every option
# is explicit.
BOTH	--config configs/mk_dev.yaml --tag inn_acr23 --prior_path /scratch/mk8347/data/crystal_datasets/conditional/priors/acridine_oldmace_oct23_prior.pt --set energy_function=mace --set mlip_path=/scratch/mk8347/data/acr_112025_mh1_stagetwo.model --set space_groups=[14] --conditioner transformer --tf_width 256 --tf_layers 4 --tf_heads 8 --n_bins 32 --n_blocks 1 --block_orders 8.11.10.9.7.6.4.2.1.0 --val_group_ignore_rows 6,7,8,9,10,11 --bounded_rows linear --tied_derivatives --tied_factor 2 --set energy_config.bounding_coeff=1000 --set energy_config.reduction_coeff=1000 --set energy_config.density_coeff=1000 --set energy_config.implausible_energy_below=-1000 --set energy_config.mlip_max_packing_coeff=2.0 --set prior_scan_cache=true --set checkpoints_dir=/scratch/mk8347/projects/gfn_cond/gfn-diffusion/energy_sampling/checkpoints --set gpu_util_sample_period_s=10 --oom_retries 3 --log_every 50 --util_target 0.75 --grow_mem_frac 1.0
MLE	--energy_steps 0 --mle_steps 20000 --lr_mle 1e-3 --mle_batch 8192 --mle_noise_log_range -1.6162 -1.6162 --eval_every 1000 --eval_samples 4000 --min_bin_height 1e-5 --bank_frac 0 --max_minutes 300 --cuda_memory_fraction 0.9
ENERGY	--mle_steps 0 --tf_fp32 --batch 2000 --updates_per_batch 5 --stored_batch 4096 --lr_energy 3e-4 --lr_energy_final 1e-5 --energy_warmup 200 --beta_data 80 --min_bin_height 1e-7 --bank_frac 0.1 --bank_additive --bank_admit 2 --bank_admit_top 1.0 --bank_max_excess 1e9 --bank_batch 256 --bank_alpha 1.0 --eval_every 500 --eval_samples 10000 --budget_minutes 2300 --max_minutes 2360 --cuda_memory_fraction 0.9
SEED_s0	-
