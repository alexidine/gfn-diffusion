.idea/
__pycache__/
wandb/
.claude/worktrees/

# Checkpoints. The suffixed forms (*.pt.detonated_*, *.pt.stale_*, *.pt.hotstart_*)
# are quarantined checkpoints, hundreds of MB each -- `*.pt` does not match them
# because the suffix moves the extension.
energy_sampling/checkpoints/*.pt
energy_sampling/checkpoints/*.pt.*
energy_sampling/checkpoints/*.npy
energy_sampling/checkpoints/*.npz

# Buffers and prior states written beside the trainer
energy_sampling/*.pt

# Generated artifacts live beside the producer that writes them. Deliberately
# NOT a blanket `energy_sampling/*.json`: a stray JSON at the top level should
# still surface as untracked, because that is the signal that an output path
# has regressed to the CWD again.
energy_sampling/bench/results/
energy_sampling/energies/results/

energy_sampling/eval/paper1_results/
energy_sampling/*.png
energy_sampling/SCRATCH/
energy_sampling/*.log
energy_sampling/logs_*.txt
energy_sampling/.vram_registry.json
